{{#if signed_in}}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    function initAuth() {
      if (typeof zE === 'undefined') {
        setTimeout(initAuth, 500);
        return;
      }
      zE('messenger:set', 'hideLauncher', true);
      // Previously this fetched /api/v2/help_center/integration/token.json
      // and passed the result into loginUser. That endpoint is real, but it
      // issues a Help Center JWT for third-party integrations — a different
      // token shape/algorithm (RS256 + Help-Center-specific claims) than
      // what Messaging's loginUser expects (HS256 + {scope, external_id,
      // name}). That mismatch caused 401 "not correct" login failures.
      // Since everyone reaching this is already an authenticated Help
      // Center visitor, useSessionAuth is the correct, documented tool for
      // this case — no custom JWT needed at all.
      zE('messenger', 'useSessionAuth');
      // The widget remembers "I was open" across page loads — without this,
      // navigating away from an active ask-ai conversation (e.g. clicking
      // "Back to Home") causes it to re-open as a floating panel on
      // whatever page loads next, since that page has no embed container
      // for it to render into. Force it closed by default everywhere
      // except the dedicated ask-ai page and the search results page, both
      // of which explicitly render it into their own embed container instead.
      try { zE('messenger', 'close'); } catch (e) {}
      fetch('/api/v2/users/me.json')
        .then(function(response) { return response.json(); })
        .then(function(data) {
          var userData = data.user;
          if (!userData || !userData.organization_id) return;
          fetch('/api/v2/organizations/' + userData.organization_id + '.json')
            .then(function(response) { return response.json(); })
            .then(function(orgData) {
              var companyName = orgData.organization && orgData.organization.name;
              if (companyName) {
                zE('messenger:set', 'conversationFields', [
                  { id: '46080466460173', value: companyName }
                ]);
                var orgLabel = document.querySelector('.sc-user__org');
                if (orgLabel) orgLabel.textContent = companyName;
              }
            });
        });
    }
    initAuth();
  });
</script>
{{/if}}

